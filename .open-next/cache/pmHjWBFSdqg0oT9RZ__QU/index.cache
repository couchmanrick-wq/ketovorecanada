{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/__PAGE__","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en\" class=\"bebas_neue_cbede6de-module__8Ur2oW__variable montserrat_5784ddf6-module__fTvjWW__variable h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/e8f2fbee2754df70-s.p.1dqa_6e_ad4sj.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/fabcf92ba1ccea36-s.p.1w_qz2ahumqmz.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2FKC_round_logo.png&amp;w=96&amp;q=75 1x, /_next/image?url=%2FKC_round_logo.png&amp;w=256&amp;q=75 2x\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0_wecghp52pfg.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3ll07n217cgxf.js\"/><script src=\"/_next/static/chunks/1htrq_0kw706i.js\" async=\"\"></script><script src=\"/_next/static/chunks/1upe53-127sm4.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2yd503-z8qhom.js\" async=\"\"></script><script src=\"/_next/static/chunks/1d4h-sglyo8ft.js\" async=\"\"></script><script src=\"/_next/static/chunks/14mumt5_n0xhi.js\" async=\"\"></script><script src=\"/_next/static/chunks/0on9ev1fw2cou.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Ketovore Canada</title><meta name=\"description\" content=\"A Ketovore Canada site exploring carnivore, keto, resources, Rick&#x27;s journey, and daily logs.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"min-h-screen bg-[#fffaf5] text-[#1f1a17]\"><section class=\"mx-auto flex max-w-7xl flex-col gap-10 px-6 py-10 lg:px-10 lg:py-16\"><header class=\"flex flex-col gap-6 rounded-[2rem] border border-[#e8d9c8] bg-white/80 p-6 shadow-sm backdrop-blur sm:p-8 lg:flex-row lg:items-center lg:justify-between lg:p-10\"><div class=\"flex items-center gap-4\"><img alt=\"Ketovore Canada logo\" width=\"72\" height=\"72\" decoding=\"async\" data-nimg=\"1\" class=\"rounded-full\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2FKC_round_logo.png&amp;w=96&amp;q=75 1x, /_next/image?url=%2FKC_round_logo.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2FKC_round_logo.png&amp;w=256&amp;q=75\"/><div><p class=\"text-sm uppercase tracking-[0.35em] text-[#8e4b1d]\">Ketovore Canada</p><h1 class=\"font-[family-name:var(--font-brusher)] text-4xl sm:text-5xl\">Ketovore</h1></div></div><div class=\"max-w-xl\"><p class=\"font-[family-name:var(--font-bebas)] text-3xl uppercase tracking-[0.26em] text-[#1f1a17] sm:text-4xl\">Canada</p><p class=\"mt-2 font-[family-name:var(--font-montserrat)] text-sm font-extrabold uppercase tracking-[0.25em] text-[#8e4b1d] sm:text-base\">Carnivore. Keto. Real food. Real change.</p></div></header><section class=\"grid gap-6 lg:grid-cols-[1.4fr_0.8fr]\"><div class=\"rounded-[2rem] bg-[#1f1a17] p-8 text-white shadow-xl sm:p-10\"><p class=\"text-sm font-semibold uppercase tracking-[0.35em] text-[#f2b26d]\">What Is Ketovore…</p><h2 class=\"mt-4 font-[family-name:var(--font-brusher)] text-4xl sm:text-5xl\">A carnivore-first, keto-inspired way of eating.</h2><p class=\"mt-5 max-w-2xl text-lg leading-8 text-[#f8efdf]\">Ketovore is the intersection of carnivore and keto: a practical approach built around animal foods, high fat, low carbohydrate intake, and a focus on simplicity. It is a lifestyle rooted in nourishment, discipline, and personal experimentation.</p><div class=\"mt-8 flex flex-wrap gap-3\"><a href=\"#resources\" class=\"rounded-full bg-[#f2b26d] px-5 py-3 font-semibold text-[#1f1a17] transition hover:bg-[#ffca82]\">Explore resources</a><a href=\"#journey\" class=\"rounded-full border border-white/30 px-5 py-3 font-semibold text-white transition hover:bg-white/10\">Read Rick&#x27;s story</a></div></div><div class=\"rounded-[2rem] border border-[#e8d9c8] bg-white p-8 shadow-sm\"><p class=\"text-sm font-semibold uppercase tracking-[0.35em] text-[#8e4b1d]\">Who is Rick Couchman</p><h3 class=\"mt-3 font-[family-name:var(--font-bebas)] text-3xl uppercase tracking-[0.16em]\">A practical guide through health, food, and change.</h3><p class=\"mt-4 text-base leading-7 text-[#4f453d]\">Rick Couchman is sharing the lessons from his own health journey, including the ups and downs of trying new ways of eating and building consistency over time.</p></div></section><section id=\"resources\" class=\"rounded-[2rem] border border-[#e8d9c8] bg-white p-8 shadow-sm sm:p-10\"><div class=\"flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between\"><div><p class=\"text-sm font-semibold uppercase tracking-[0.35em] text-[#8e4b1d]\">Resources…</p><h2 class=\"font-[family-name:var(--font-bebas)] text-3xl uppercase tracking-[0.16em] sm:text-4xl\">Useful tools, voices, and links.</h2></div><p class=\"max-w-xl text-sm leading-7 text-[#6f655d]\">A curated collection of podcasts, videos, websites, recipes, and people worth following as you explore this path.</p></div><div class=\"mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3\"><article class=\"rounded-2xl border border-[#efe2d1] bg-[#fffaf5] p-5\"><h3 class=\"font-[family-name:var(--font-bebas)] text-2xl uppercase tracking-[0.12em] text-[#1f1a17]\">Podcasts</h3><p class=\"mt-2 text-sm leading-7 text-[#645a53]\">Stories, interviews, and practical guidance from the Ketovore community.</p></article><article class=\"rounded-2xl border border-[#efe2d1] bg-[#fffaf5] p-5\"><h3 class=\"font-[family-name:var(--font-bebas)] text-2xl uppercase tracking-[0.12em] text-[#1f1a17]\">YouTube</h3><p class=\"mt-2 text-sm leading-7 text-[#645a53]\">Video explains the keto-carnivore approach in plain language.</p></article><article class=\"rounded-2xl border border-[#efe2d1] bg-[#fffaf5] p-5\"><h3 class=\"font-[family-name:var(--font-bebas)] text-2xl uppercase tracking-[0.12em] text-[#1f1a17]\">Influencers to Follow</h3><p class=\"mt-2 text-sm leading-7 text-[#645a53]\">A growing list of voices shaping the low-carb and carnivore conversation.</p></article><article class=\"rounded-2xl border border-[#efe2d1] bg-[#fffaf5] p-5\"><h3 class=\"font-[family-name:var(--font-bebas)] text-2xl uppercase tracking-[0.12em] text-[#1f1a17]\">Websites</h3><p class=\"mt-2 text-sm leading-7 text-[#645a53]\">Trusted resources for research, recipes, and inspiration.</p></article><article class=\"rounded-2xl border border-[#efe2d1] bg-[#fffaf5] p-5\"><h3 class=\"font-[family-name:var(--font-bebas)] text-2xl uppercase tracking-[0.12em] text-[#1f1a17]\">Recipes</h3><p class=\"mt-2 text-sm leading-7 text-[#645a53]\">Simple meals built around meat, eggs, butter, and high-fat staples.</p></article></div></section><section id=\"updates\" class=\"grid gap-6 lg:grid-cols-[1.1fr_0.9fr]\"><div class=\"rounded-[2rem] border border-[#e8d9c8] bg-[#fff7eb] p-8 shadow-sm sm:p-10\"><p class=\"text-sm font-semibold uppercase tracking-[0.35em] text-[#8e4b1d]\">The Latest Updates…</p><h2 class=\"mt-3 font-[family-name:var(--font-bebas)] text-3xl uppercase tracking-[0.16em] sm:text-4xl\">Stories, notes, and fresh thinking.</h2><div class=\"mt-6 space-y-4\"><div class=\"rounded-2xl border border-[#e7d7c2] bg-white p-4\"><h3 class=\"font-semibold text-[#1f1a17]\">Latest Updates</h3><p class=\"mt-2 text-sm leading-7 text-[#645a53]\">Fresh notes, interviews, and community highlights from the journey.</p></div><div class=\"rounded-2xl border border-[#e7d7c2] bg-white p-4\"><h3 class=\"font-semibold text-[#1f1a17]\">Newsletter</h3><p class=\"mt-2 text-sm leading-7 text-[#645a53]\">Subscribe for practical insights, progress updates, and new resources.</p></div></div></div><div class=\"rounded-[2rem] border border-[#e8d9c8] bg-white p-8 shadow-sm sm:p-10\"><p class=\"text-sm font-semibold uppercase tracking-[0.35em] text-[#8e4b1d]\">Newsletter</p><h3 class=\"mt-3 font-[family-name:var(--font-bebas)] text-3xl uppercase tracking-[0.16em]\">Stay in touch.</h3><p class=\"mt-4 text-base leading-7 text-[#645a53]\">Subscribe for updates, new resources, and reflections from the journey as they are released.</p><a href=\"mailto:hello@ketovorecanada.com\" class=\"mt-6 inline-flex rounded-full bg-[#1f1a17] px-5 py-3 font-semibold text-white transition hover:bg-[#333]\">hello@ketovorecanada.com</a></div></section><section id=\"journey\" class=\"rounded-[2rem] border border-[#e8d9c8] bg-white p-8 shadow-sm sm:p-10\"><p class=\"text-sm font-semibold uppercase tracking-[0.35em] text-[#8e4b1d]\">Rick&#x27;s Journey…</p><h2 class=\"mt-3 font-[family-name:var(--font-bebas)] text-3xl uppercase tracking-[0.16em] sm:text-4xl\">A personal path toward better health and better habits.</h2><div class=\"mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3\"><article class=\"rounded-2xl border border-[#efe2d1] bg-[#fffaf5] p-5\"><h3 class=\"font-[family-name:var(--font-bebas)] text-2xl uppercase tracking-[0.12em] text-[#1f1a17]\">About Rick</h3><p class=\"mt-2 text-sm leading-7 text-[#645a53]\">Rick Couchman shares his personal experience with health, food, and discipline.</p></article><article class=\"rounded-2xl border border-[#efe2d1] bg-[#fffaf5] p-5\"><h3 class=\"font-[family-name:var(--font-bebas)] text-2xl uppercase tracking-[0.12em] text-[#1f1a17]\">Meds</h3><p class=\"mt-2 text-sm leading-7 text-[#645a53]\">A candid look at medications, changes, and what is being monitored.</p></article><article class=\"rounded-2xl border border-[#efe2d1] bg-[#fffaf5] p-5\"><h3 class=\"font-[family-name:var(--font-bebas)] text-2xl uppercase tracking-[0.12em] text-[#1f1a17]\">Health Issues</h3><p class=\"mt-2 text-sm leading-7 text-[#645a53]\">A framework for understanding the health challenges behind the journey.</p></article><article class=\"rounded-2xl border border-[#efe2d1] bg-[#fffaf5] p-5\"><h3 class=\"font-[family-name:var(--font-bebas)] text-2xl uppercase tracking-[0.12em] text-[#1f1a17]\">Daily Log</h3><p class=\"mt-2 text-sm leading-7 text-[#645a53]\">Weight, insulin, steps, gym, measurements, food, and photos in one place.</p></article><article class=\"rounded-2xl border border-[#efe2d1] bg-[#fffaf5] p-5\"><h3 class=\"font-[family-name:var(--font-bebas)] text-2xl uppercase tracking-[0.12em] text-[#1f1a17]\">Blog</h3><p class=\"mt-2 text-sm leading-7 text-[#645a53]\">Thoughtful write-ups that connect personal progress to practical lessons.</p></article></div></section><section class=\"rounded-[2rem] border border-[#e8d9c8] bg-[#1f1a17] p-8 text-white shadow-sm sm:p-10\"><p class=\"text-sm font-semibold uppercase tracking-[0.35em] text-[#f2b26d]\">Daily Log…</p><h2 class=\"mt-3 font-[family-name:var(--font-bebas)] text-3xl uppercase tracking-[0.16em] sm:text-4xl\">Weight, insulin, steps, gym, measurements, food, and photos.</h2><p class=\"mt-4 max-w-3xl text-base leading-8 text-[#f8efdf]\">The daily log section will become a richer dashboard over time, with charts, food timing details, body measurements, and progress photos that make the journey easier to follow.</p></section></section></main><!--$--><!--/$--><script src=\"/_next/static/chunks/3ll07n217cgxf.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39756,[\\\"/_next/static/chunks/1d4h-sglyo8ft.js\\\",\\\"/_next/static/chunks/14mumt5_n0xhi.js\\\"],\\\"default\\\"]\\n3:I[37457,[\\\"/_next/static/chunks/1d4h-sglyo8ft.js\\\",\\\"/_next/static/chunks/14mumt5_n0xhi.js\\\"],\\\"default\\\"]\\n4:I[5500,[\\\"/_next/s