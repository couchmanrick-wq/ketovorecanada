{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ketovorecanada",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "ketovorecanada.com/*", "zone_name": "ketovorecanada.com" },
    { "pattern": "*.ketovorecanada.com/*", "zone_name": "ketovorecanada.com" }
  ],
  "observability": {
    "enabled": true
  },
  // ADMIN_PASSWORD is NOT here on purpose — set it as an encrypted secret
  // with `npx wrangler secret put ADMIN_PASSWORD`.
  "vars": {
    "ADMIN_USERNAME": "Rick"
  },
  "kv_namespaces": [
    {
      "binding": "DAILY_LOG_KV",
      "id": "0b5da19563274372998336dee628e1ae"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
