{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ketovorecanada",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "ketovorecanada.com/*", "zone_name": "ketovorecanada.com" },
    { "pattern": "*.ketovorecanada.com/*", "zone_name": "ketovorecanada.com" }
  ],
  "observability": {
    "enabled": true
  },
  // Secrets (set with `npx wrangler secret put <NAME>`, NOT here):
  //   ADMIN_PASSWORD       — admin basic-auth
  //   TURNSTILE_SECRET_KEY — Cloudflare Turnstile (falls back to the always-pass test key)
  //   RESEND_API_KEY       — Resend, for comment email confirmation (comments are
  //                          email-gated only once this is set)
  "vars": {
    "ADMIN_USERNAME": "Rick",
    // Turnstile always-pass TEST key — replace with the real site key once the
    // widget is created (pair with the TURNSTILE_SECRET_KEY secret).
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "COMMENTS_FROM_EMAIL": "Ketovore Canada <comments@ketovorecanada.com>",
    "SITE_ORIGIN": "https://ketovorecanada.com"
  },
  "kv_namespaces": [
    {
      "binding": "DAILY_LOG_KV",
      "id": "0b5da19563274372998336dee628e1ae"
    }
  ],
  // Shared with the ketovorecanada-ingest Worker, which populates the `videos`
  // table from YouTube RSS on a cron. Read-only here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ketovore-content",
      "database_id": "d4322381-e987-41fc-b76d-a1c97cac52e0"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
